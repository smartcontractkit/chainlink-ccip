set fallback

# Default: show available recipes
default:
    just --list

clean:
    rm -rf compose/ blockscout/

# Install pre-commit hooks
pre-commit:
    pre-commit install

# Clone and build job-distributor Docker image
build-jd-docker:
    #!/usr/bin/env bash
    set -e
    REPO_URL="git@github.com:smartcontractkit/job-distributor.git"
    REPO_DIR="job-distributor/"
    IMAGE_NAME="job-distributor:local"
    DOCKERFILE="e2e/Dockerfile.e2e"
    if docker image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
        echo "Docker image $IMAGE_NAME already exists, skipping build..."
    else
        echo "Cloning repository... check for 2-factor authentication"
        git clone "$REPO_URL" "$REPO_DIR" --depth 1
        echo "Building Docker image..."
        cd "$REPO_DIR" && docker build -t "$IMAGE_NAME" -f "$DOCKERFILE" .
        cd ..
        rm -rf job-distributor/
    fi
    echo "Done!"

# Agave version of the Solana validator image. Keep it equal to the image tag in env.toml.
agave_version := "4.4.1"

# Agave no longer publishes Docker images, and only ships x86_64 Linux binaries: on
# arm64 the image is compiled from source, which takes a while the first time. The
# build is always native, because Agave needs io_uring and Rosetta does not support it.

# Build the Solana validator Docker image
build-solana-validator-docker:
    #!/usr/bin/env bash
    set -e
    IMAGE_NAME="solana-validator:agave-{{agave_version}}"
    if docker image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
        echo "Docker image $IMAGE_NAME already exists, skipping build..."
        exit 0
    fi
    case "$(uname -m)" in
        arm64|aarch64) ARCH=arm64; TARGET=source ;;
        *)             ARCH=amd64; TARGET=release ;;
    esac
    docker build -f images/solana-validator/Dockerfile \
        --platform "linux/$ARCH" \
        --target "$TARGET" \
        --build-arg AGAVE_VERSION={{agave_version}} \
        -t "$IMAGE_NAME" \
        images/solana-validator
    echo "Done!"

# Rebuild CLI
cli:
    pushd cmd/ccip > /dev/null && go install -ldflags="-X main.Version=1.0.0" . && popd > /dev/null
